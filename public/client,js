const socket = io();

const cardsDiv = document.getElementById("cards");
const myCardDiv = document.getElementById("mycard");
const countdownEl = document.getElementById("countdown");
const lastEl = document.getElementById("last");

let userId = Math.floor(Math.random() * 999999);

/* ================= SHOW CARDS ================= */
socket.on("cardsList", (cards) => {
  cardsDiv.innerHTML = "";

  cards.forEach(c => {
    let div = document.createElement("div");
    div.className = "card";

    div.innerHTML = c.numbers.map(n =>
      `<span class="num">${n}</span>`
    ).join("");

    div.onclick = () => {
      socket.emit("chooseCard", {
        userId,
        cardId: c.id
      });
    };

    cardsDiv.appendChild(div);
  });
});

/* ================= SELECTED CARD ================= */
socket.on("cardSelected", (card) => {
  myCardDiv.innerHTML = card.numbers.map(n =>
    `<span class="num">${n}</span>`
  ).join("");
});

/* ================= COUNTDOWN ================= */
socket.on("countdown", (data) => {
  countdownEl.innerText = "Starts in: " + data.countdown;
});

/* ================= GAME ================= */
socket.on("number", (data) => {
  lastEl.innerText = data.number;
});

/* ================= WINNER ================= */
socket.on("winner", (data) => {
  alert("🏆 WINNER: " + data.userId);
});