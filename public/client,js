const socket = io();

const countdownEl = document.getElementById("countdown");
const lastEl = document.getElementById("last");
const calledEl = document.getElementById("called");

/* ================= COUNTDOWN ================= */
socket.on("countdown", (data) => {
  countdownEl.innerText = "Game starts in: " + data.countdown + "s";
});

/* ================= GAME START ================= */
socket.on("gameStart", () => {
  countdownEl.innerText = "🎮 GAME STARTED!";
  calledEl.innerHTML = "";
  lastEl.innerText = "-";
});

/* ================= NUMBER ================= */
socket.on("number", (data) => {
  lastEl.innerText = data.number;

  calledEl.innerHTML += `<span class="number">${data.number}</span>`;
});

/* ================= RESET ================= */
socket.on("reset", () => {
  calledEl.innerHTML = "";
  lastEl.innerText = "-";
});

/* ================= WINNER ================= */
socket.on("winner", () => {
  alert("🏆 WINNER FOUND!");
});