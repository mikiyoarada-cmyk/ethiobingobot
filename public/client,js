const socket = io();

const countdownEl = document.getElementById("countdown");
const lastEl = document.getElementById("last");
const cardEl = document.getElementById("card");

let userId = Math.floor(Math.random() * 999999);

/* ================= COUNTDOWN ================= */
socket.on("countdown", (data) => {
  countdownEl.innerText = "Game starts in " + data.countdown + "s";
});

/* ================= GAME START ================= */
socket.on("gameStart", () => {
  countdownEl.innerText = "🎮 GAME STARTED";
});

/* ================= NUMBER ================= */
socket.on("number", (data) => {
  lastEl.innerText = data.number;
});

/* ================= YOUR CARD ================= */
socket.emit("getCard", userId);

socket.on("yourCard", (card) => {
  cardEl.innerHTML = card.numbers.map(n => `<span class="num">${n}</span>`).join("");
});

/* ================= RESET ================= */
socket.on("reset", () => {
  lastEl.innerText = "-";
});

/* ================= WINNER ================= */
socket.on("winner", (data) => {
  alert("🏆 WINNER: " + data.userId);
});